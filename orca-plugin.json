{
  "manifestVersion": 2,
  "id": "line-blame",
  "name": "Line Blame",
  "version": "0.1.2",
  "description": "See who changed a line, when and why, without leaving Orca. Click a line for its commit, then step back through the commits that changed it before.",
  "icon": "images/icon.png",
  "cover": {
    "path": "images/cover.png",
    "alt": "A code file in the Blame view: the clicked line shows its author, date and commit title, and a card shows what that commit changed."
  },
  "screenshots": [
    {
      "path": "images/screenshot-blame.png",
      "alt": "The clicked line shows who changed it and when; a card shows the commit message and the line before and after.",
      "caption": "Click a line to see who changed it. Hover to see what the commit changed."
    },
    {
      "path": "images/screenshot-history.png",
      "alt": "The card pinned on an earlier change of the same line, with buttons to step earlier and later.",
      "caption": "Step back through every commit that changed the line."
    },
    {
      "path": "images/screenshot-find.png",
      "alt": "The find bar open with every match highlighted in the file.",
      "caption": "Find in the file; each match shows its blame."
    }
  ],
  "author": {
    "name": "yeonjin1357",
    "url": "https://github.com/yeonjin1357"
  },
  "repository": "https://github.com/yeonjin1357/orca-line-blame",
  "homepage": "https://github.com/yeonjin1357/orca-line-blame",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "workspace:read"
    }
  ],
  "contributes": {
    "customEditors": [
      {
        "id": "blame",
        "title": "Blame",
        "extensions": [
          ".vue",
          ".svelte",
          ".astro",
          ".ts",
          ".tsx",
          ".mts",
          ".cts",
          ".js",
          ".jsx",
          ".mjs",
          ".cjs",
          ".html",
          ".htm",
          ".xhtml",
          ".css",
          ".scss",
          ".sass",
          ".less",
          ".styl",
          ".pcss",
          ".coffee",
          ".elm",
          ".ejs",
          ".hbs",
          ".handlebars",
          ".mustache",
          ".pug",
          ".twig",
          ".njk",
          ".liquid",
          ".jinja",
          ".j2"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      },
      {
        "id": "blame-data",
        "title": "Blame",
        "extensions": [
          ".json",
          ".jsonc",
          ".json5",
          ".yaml",
          ".yml",
          ".toml",
          ".ini",
          ".cfg",
          ".conf",
          ".properties",
          ".xml",
          ".xsd",
          ".xsl",
          ".xslt",
          ".plist",
          ".md",
          ".markdown",
          ".mdx",
          ".rst",
          ".adoc",
          ".asciidoc",
          ".txt",
          ".tex",
          ".sty",
          ".bib",
          ".org",
          ".feature",
          ".diff",
          ".patch",
          ".http",
          ".rest"
        ],
        "filenames": [
          ".gitignore",
          ".gitattributes",
          ".gitmodules",
          ".dockerignore",
          ".npmignore",
          ".eslintignore",
          ".prettierignore",
          ".editorconfig",
          ".prettierrc",
          ".eslintrc",
          ".babelrc",
          ".nvmrc",
          ".browserslistrc",
          ".stylelintrc",
          "CODEOWNERS"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      },
      {
        "id": "blame-shell",
        "title": "Blame",
        "extensions": [
          ".sh",
          ".bash",
          ".zsh",
          ".ksh",
          ".fish",
          ".ps1",
          ".psm1",
          ".psd1",
          ".bat",
          ".cmd",
          ".awk",
          ".tcl",
          ".vim",
          ".mk",
          ".cmake",
          ".dockerfile",
          ".nginx",
          ".tf",
          ".tfvars",
          ".hcl",
          ".nix",
          ".bzl",
          ".bazel",
          ".pp",
          ".sql",
          ".pgsql",
          ".prisma",
          ".graphql",
          ".graphqls",
          ".gql",
          ".proto",
          ".thrift"
        ],
        "filenames": [
          "Dockerfile",
          "Containerfile",
          "Makefile",
          "GNUmakefile",
          "CMakeLists.txt",
          "Jenkinsfile",
          "Vagrantfile",
          "Procfile",
          "Justfile",
          "Caddyfile",
          "BUILD",
          "WORKSPACE",
          ".bashrc",
          ".zshrc",
          ".profile",
          ".bash_profile"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      },
      {
        "id": "blame-jvm-dotnet",
        "title": "Blame",
        "extensions": [
          ".java",
          ".kt",
          ".kts",
          ".scala",
          ".sc",
          ".groovy",
          ".gradle",
          ".clj",
          ".cljs",
          ".cljc",
          ".edn",
          ".jsp",
          ".cs",
          ".csx",
          ".fs",
          ".fsx",
          ".fsi",
          ".vb",
          ".vbs",
          ".razor",
          ".cshtml",
          ".xaml",
          ".csproj",
          ".fsproj",
          ".vbproj",
          ".sln",
          ".props",
          ".targets"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      },
      {
        "id": "blame-native",
        "title": "Blame",
        "extensions": [
          ".c",
          ".h",
          ".cpp",
          ".cc",
          ".cxx",
          ".hpp",
          ".hh",
          ".hxx",
          ".ino",
          ".m",
          ".mm",
          ".swift",
          ".go",
          ".rs",
          ".zig",
          ".nim",
          ".d",
          ".cr",
          ".v",
          ".sv",
          ".svh",
          ".vhd",
          ".vhdl",
          ".asm",
          ".ll",
          ".glsl",
          ".vert",
          ".frag",
          ".wat"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      },
      {
        "id": "blame-scripting",
        "title": "Blame",
        "extensions": [
          ".py",
          ".pyi",
          ".pyw",
          ".pyx",
          ".rb",
          ".rake",
          ".gemspec",
          ".erb",
          ".haml",
          ".php",
          ".phtml",
          ".pl",
          ".pm",
          ".lua",
          ".r",
          ".jl",
          ".dart",
          ".ex",
          ".exs",
          ".erl",
          ".hrl",
          ".hs",
          ".ml",
          ".mli",
          ".sml",
          ".lisp",
          ".el",
          ".scm",
          ".rkt",
          ".sol",
          ".gd",
          ".hx"
        ],
        "filenames": [
          "Gemfile",
          "Rakefile",
          "Podfile",
          "Fastfile",
          "Brewfile"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      },
      {
        "id": "blame-more",
        "title": "Blame",
        "extensions": [
          ".pas",
          ".adb",
          ".ads",
          ".f90",
          ".f95",
          ".f",
          ".for",
          ".vala",
          ".qml",
          ".applescript"
        ],
        "entry": "editor/main.ts",
        "priority": "option",
        "frame": "isolated"
      }
    ]
  }
}
